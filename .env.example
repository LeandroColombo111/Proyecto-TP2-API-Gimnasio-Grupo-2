PORT=8000
NODE_ENV=development
PERSISTENCE_TYPE=memory
DB_STORAGE=./database.sqlite
CUPO_BAJO_THRESHOLD=2
NOTIFIER_TYPE=console
ALERT_NOTIFIER_TYPE=file

# Autenticación: son valores de ejemplo, cambialos en tu .env (el .env no se versiona)
JWT_SECRET=cambiar-por-un-secreto-propio
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@gimnasio.com
ADMIN_PASSWORD=admin1234
