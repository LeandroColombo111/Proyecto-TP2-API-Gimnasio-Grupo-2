@baseUrl = http://localhost:8000

### Health
GET {{baseUrl}}/health

### Ruta inexistente
GET {{baseUrl}}/nada

########## SOCIOS ##########

### Listar socios
GET {{baseUrl}}/socios

### Obtener socio por id
GET {{baseUrl}}/socios/1

### Socio inexistente
GET {{baseUrl}}/socios/999

### Id inválido
GET {{baseUrl}}/socios/abc

### Crear socio
POST {{baseUrl}}/socios
Content-Type: application/json

{
  "nombre": "Julia",
  "apellido": "Medina",
  "email": "julia.medina@mail.com",
  "dni": "33444555",
  "telefono": "1155550010"
}

### Crear socio sin teléfono
POST {{baseUrl}}/socios
Content-Type: application/json

{
  "nombre": "Pablo",
  "apellido": "Ibarra",
  "email": "pablo.ibarra@mail.com",
  "dni": "34555666"
}

### Email duplicado
POST {{baseUrl}}/socios
Content-Type: application/json

{
  "nombre": "Otro",
  "apellido": "Socio",
  "email": "lucia.fernandez@mail.com",
  "dni": "40000001"
}

### DNI duplicado
POST {{baseUrl}}/socios
Content-Type: application/json

{
  "nombre": "Otro",
  "apellido": "Socio",
  "email": "otro@mail.com",
  "dni": "30123456"
}

### Body vacío
POST {{baseUrl}}/socios
Content-Type: application/json

{}

### Email y DNI inválidos
POST {{baseUrl}}/socios
Content-Type: application/json

{
  "nombre": "X",
  "apellido": "Y",
  "email": "no-es-un-email",
  "dni": "12"
}

### JSON mal formado
POST {{baseUrl}}/socios
Content-Type: application/json

{ "nombre": "Julia", }

### Modificar socio
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{
  "telefono": "1155559999"
}

### Modificar conservando su propio email
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{
  "email": "lucia.fernandez@mail.com"
}

### Modificar con el email de otro socio
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{
  "email": "martin.gomez@mail.com"
}

### Modificar con el DNI de otro socio
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{
  "dni": "32456789"
}

### Modificar sin campos
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{}

### Modificar con campo desconocido
PUT {{baseUrl}}/socios/1
Content-Type: application/json

{
  "edad": 30
}

### Modificar socio inexistente
PUT {{baseUrl}}/socios/999
Content-Type: application/json

{
  "nombre": "Nadie"
}

### Borrar socio
DELETE {{baseUrl}}/socios/3

### Borrar socio inexistente
DELETE {{baseUrl}}/socios/999

########## CLASES ##########

### Listar clases
GET {{baseUrl}}/clases

### Obtener clase por id
GET {{baseUrl}}/clases/2

### Clase inexistente
GET {{baseUrl}}/clases/999

### Id inválido
GET {{baseUrl}}/clases/abc

### Crear clase
POST {{baseUrl}}/clases
Content-Type: application/json

{
  "nombre": "Pilates",
  "instructor": "Marina Ruiz",
  "dia": "martes",
  "horario": "10:30",
  "cupoMaximo": 12
}

### Día inválido
POST {{baseUrl}}/clases
Content-Type: application/json

{
  "nombre": "Pilates",
  "instructor": "Marina Ruiz",
  "dia": "domingo",
  "horario": "10:30",
  "cupoMaximo": 12
}

### Horario inválido
POST {{baseUrl}}/clases
Content-Type: application/json

{
  "nombre": "Pilates",
  "instructor": "Marina Ruiz",
  "dia": "martes",
  "horario": "25:99",
  "cupoMaximo": 12
}

### Cupo inválido
POST {{baseUrl}}/clases
Content-Type: application/json

{
  "nombre": "Pilates",
  "instructor": "Marina Ruiz",
  "dia": "martes",
  "horario": "10:30",
  "cupoMaximo": 0
}

### Body vacío
POST {{baseUrl}}/clases
Content-Type: application/json

{}

### Modificar clase
PUT {{baseUrl}}/clases/1
Content-Type: application/json

{
  "horario": "09:00"
}

### Modificar cupo máximo
PUT {{baseUrl}}/clases/1
Content-Type: application/json

{
  "cupoMaximo": 20
}

### cuposDisponibles no se puede enviar
PUT {{baseUrl}}/clases/1
Content-Type: application/json

{
  "cuposDisponibles": 5
}

### Modificar clase inexistente
PUT {{baseUrl}}/clases/999
Content-Type: application/json

{
  "nombre": "Nada"
}

### Borrar clase
DELETE {{baseUrl}}/clases/3

### Borrar clase inexistente
DELETE {{baseUrl}}/clases/999

########## FILTROS, ORDEN Y PAGINACIÓN ##########

### Socios paginados y ordenados
GET {{baseUrl}}/socios?limit=1&page=2&sort=-apellido

### Socios activos que matchean el texto
GET {{baseUrl}}/socios?activo=true&q=gom

### Socios inactivos
GET {{baseUrl}}/socios?activo=false

### page inválida
GET {{baseUrl}}/socios?page=0

### sort inválido
GET {{baseUrl}}/socios?sort=edad

### limit mayor al máximo
GET {{baseUrl}}/socios?limit=101

### Clases con cupo, ordenadas por horario descendente
GET {{baseUrl}}/clases?conCupo=true&sort=-horario&limit=2

### Clases de un día y un instructor
GET {{baseUrl}}/clases?dia=lunes&instructor=carl

### Día inválido
GET {{baseUrl}}/clases?dia=domingo

########## INSCRIPCIONES ##########
# Spinning (clase 2) tiene cupo 2; el socio 3 está inactivo.
# Reiniciar el server para volver a los datos semilla.

### Inscribir socio 1 en Spinning
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 1,
  "claseId": 2
}

### Ya inscripto
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 1,
  "claseId": 2
}

### Inscribir socio 2 en Spinning
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 2,
  "claseId": 2
}

### Sin cupo: el socio 4 se crea antes con POST /socios
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 4,
  "claseId": 2
}

### Socio inactivo
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 3,
  "claseId": 1
}

### Socio inexistente
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 999,
  "claseId": 1
}

### Clase inexistente
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 1,
  "claseId": 999
}

### Body inválido
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": "a"
}

### Listar inscripciones
GET {{baseUrl}}/inscripciones

### Filtrar por clase y estado
GET {{baseUrl}}/inscripciones?claseId=2&estado=activa

### Estado inválido
GET {{baseUrl}}/inscripciones?estado=otra

### Obtener inscripción por id
GET {{baseUrl}}/inscripciones/1

### Inscripción inexistente
GET {{baseUrl}}/inscripciones/999

########## RELACIÓN N A N Y REGLAS CRUZADAS ##########

### Clases del socio 1
GET {{baseUrl}}/socios/1/clases

### Socios de la clase 2
GET {{baseUrl}}/clases/2/socios

### Socio inexistente
GET {{baseUrl}}/socios/999/clases

### Clase inexistente
GET {{baseUrl}}/clases/999/socios

### Borrar socio con inscripción activa
DELETE {{baseUrl}}/socios/1

### Borrar clase con inscripciones activas
DELETE {{baseUrl}}/clases/2

### Bajar el cupo por debajo de los inscriptos
PUT {{baseUrl}}/clases/2
Content-Type: application/json

{
  "cupoMaximo": 1
}

### Subir el cupo
PUT {{baseUrl}}/clases/2
Content-Type: application/json

{
  "cupoMaximo": 5
}

### Cancelar inscripción
PATCH {{baseUrl}}/inscripciones/1/cancelar

### Cancelar de nuevo
PATCH {{baseUrl}}/inscripciones/1/cancelar

### Cancelar inscripción inexistente
PATCH {{baseUrl}}/inscripciones/999/cancelar

########## EVENTOS ##########

### Inscripción en Yoga
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 1,
  "claseId": 3
}

### Inscripción en Spinning
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 2,
  "claseId": 2
}

### Inscripción con socio inexistente
POST {{baseUrl}}/inscripciones
Content-Type: application/json

{
  "socioId": 999,
  "claseId": 2
}
